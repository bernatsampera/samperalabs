---
import PageLayout from '~/layouts/PageLayout.astro';
import {stories} from '~/lib/stories';
import type {MetaData} from '~/types';
import type {TOCItem} from '~/utils/tableOfContents';
import {buildNestedTOC} from '~/utils/tableOfContents';
import ReadingContents from '~/components/common/ReadingContents.astro';

export interface Props {
  metadata?: MetaData;
  headings?: TOCItem[];
  post: {
    title: string;
    author: string;
    pub_date: string;
    description?: string;
    content: string;
    status?: 'draft' | 'published';
  };
}

const {metadata, post, headings = []} = Astro.props;
const readingTime = Math.max(Math.floor(post.content.length / 1000), 1);
const pubDate = new Date(post.pub_date);
const formattedDate = pubDate.toLocaleDateString('en-GB', {day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC'});
const contents = buildNestedTOC(headings.map((heading) => ({...heading, level: Math.max(2, heading.level)})));
const relatedStories = stories.filter(story => story.chapters.some(chapter => chapter.article?.href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, '')));
const back = '<svg class="ico" viewBox="0 0 12 12" aria-hidden="true"><path d="M7.5 2.5 4 6l3.5 3.5"></path></svg>';
---

<PageLayout metadata={metadata}>
  <div class:list={['reading-page', {'has-contents': headings.length > 0}]}>
    {headings.length > 0 && (
      <aside class="reading-rail">
        <nav aria-label="On this page">
          <p class="contents-label">On this page</p>
          <ReadingContents items={contents} />
        </nav>
      </aside>
    )}
    <article class="reading-paper">
      <a class="link reading-back" href="/writing"><Fragment set:html={back} />All writing</a>
      <header class="reading-head">
        <p class="meta reading-byline">
          {post.status === 'draft' ? <span>Draft for review</span> : <time datetime={post.pub_date}>{formattedDate}</time>}, {readingTime} min read
        </p>
        <h1>{post.title}</h1>
        {post.description && <p class="reading-description">{post.description}</p>}
        {post.author && <p class="meta reading-author">Written by {post.author}</p>}
      </header>
      {headings.length > 0 && (
        <details class="reading-mobile-contents">
          <summary>On this page</summary>
          <nav aria-label="On this page">
            <ReadingContents items={contents} />
          </nav>
        </details>
      )}
      <slot />
      {relatedStories.length > 0 && <aside class="related-projects" aria-label="Related projects"><h2>The project behind this article</h2>{relatedStories.map(story => <a class="link" href={"/" + story.slug}>Explore {story.name}</a>)}</aside>}
      <a class="link reading-end" href="/writing"><Fragment set:html={back} />All writing</a>
    </article>
  </div>
</PageLayout>

<style is:global>
  .related-projects { margin-top: 48px; padding: 24px 0; border-top: 1px solid var(--color-rule); }
  .related-projects h2 { font-size: var(--type-heading); margin: 0 0 16px; }
  .related-projects a { margin-right: 24px; }
  /* Article pages. Values come from tokens.css. The text column sits on the left edge of the 900px column. */
  .reading-page { display: grid; grid-template-columns: minmax(0, 1fr) min(var(--column), 100% - 2 * var(--gutter)) minmax(0, 1fr); padding: var(--space-8) 0 0; }
  .reading-paper { grid-column: 2; min-width: 0; }
  .reading-back { margin-bottom: var(--space-6); }
  .reading-head { max-width: 760px; padding-bottom: var(--space-7); }
  .reading-byline { margin-bottom: var(--space-3); }
  .reading-head h1 { margin: 0; font-size: var(--type-title); line-height: var(--leading-title); letter-spacing: var(--tracking-title); font-weight: var(--weight-medium); overflow-wrap: anywhere; }
  .reading-description { margin: var(--space-5) 0 0; max-width: 680px; font-size: var(--type-heading); line-height: var(--leading-heading); color: var(--color-slate); }
  .reading-author { margin-top: var(--space-5); }
  .reading-end { margin-top: var(--space-8); }

  /* Contents: a rail in the left margin on wide screens, a disclosure elsewhere. */
  .reading-rail { display: none; }
  .reading-page ol.reading-contents-list { list-style: none; margin: 0; padding: 0; }
  .reading-page .reading-contents-nested { margin: 2px 0 var(--space-2) var(--space-3); padding-left: var(--space-3); border-left: var(--border-hairline); }
  .reading-page [data-reading-link] { display: block; padding: 6px var(--space-2); border-radius: 6px; color: var(--color-graphite); font-size: var(--type-small); line-height: var(--leading-small); text-decoration: none; overflow-wrap: anywhere; }
  .reading-page .reading-contents-nested [data-reading-link] { color: var(--color-slate); font-size: var(--type-meta); line-height: var(--leading-meta); }
  .reading-page [data-reading-link]:hover { color: var(--color-ink); background: var(--color-panel); }
  .reading-page [data-reading-link][aria-current="location"] { color: var(--color-ink); background: var(--color-canvas); font-weight: var(--weight-medium); }
  .contents-label { margin: 0 0 var(--space-3); padding-left: var(--space-2); font-size: var(--type-meta); line-height: var(--leading-meta); color: var(--color-slate); }
  .reading-mobile-contents { max-width: 680px; margin-bottom: var(--space-7); border: var(--border-hairline); border-radius: var(--radius-panel); padding: 0 var(--space-4); }
  .reading-mobile-contents summary { min-height: 44px; display: flex; align-items: center; cursor: pointer; font-size: var(--type-ui); font-weight: var(--weight-medium); }
  .reading-mobile-contents nav { max-height: 45svh; overflow-y: auto; padding-bottom: var(--space-3); }
  @media (min-width: 1360px) {
    .reading-rail { display: block; grid-column: 1; grid-row: 1; justify-self: end; position: sticky; top: calc(var(--site-header-h) + var(--space-6)); align-self: start; width: 220px; max-height: calc(100svh - var(--site-header-h) - 48px); overflow-y: auto; margin: 0 var(--space-7) 0 0; }
    .reading-mobile-contents { display: none; }
  }

  /* Prose: one family, reading text in graphite on a 680px measure. */
  .reading-page .reading-prose { max-width: 680px; font-family: var(--font-sans); font-size: var(--type-lede); line-height: 28px; color: var(--color-graphite); overflow-wrap: break-word; }
  .reading-page .reading-prose p { margin: 0 0 var(--space-5); }
  .reading-page .reading-prose :is(h1, h2, h3, h4, h5, h6) { color: var(--color-ink); font-weight: var(--weight-medium); scroll-margin-top: var(--space-6); }
  .reading-page .reading-prose :is(h1, h2) { margin: var(--space-8) 0 var(--space-4); font-size: var(--type-section-phone); line-height: var(--leading-section-phone); letter-spacing: -.4px; }
  .reading-page .reading-prose h3 { margin: var(--space-7) 0 var(--space-3); font-size: var(--type-heading); line-height: var(--leading-heading); letter-spacing: var(--tracking-heading); }
  .reading-page .reading-prose :is(h4, h5, h6) { margin: var(--space-6) 0 var(--space-2); font-size: var(--type-lede); line-height: var(--leading-lede); }
  .reading-page .reading-prose a { color: var(--color-accent); font-weight: var(--weight-medium); text-decoration: underline; text-decoration-color: var(--color-accent-wash); text-decoration-thickness: 2px; text-underline-offset: 4px; }
  .reading-page .reading-prose a:hover { text-decoration-color: var(--color-accent); }
  .reading-page .reading-prose strong { color: var(--color-ink); font-weight: 600; }
  .reading-page .reading-prose :is(ul, ol) { margin: 0 0 var(--space-5); padding-left: 1.4em; }
  .reading-page .reading-prose ul { list-style: disc; }
  .reading-page .reading-prose ol { list-style: decimal; }
  .reading-page .reading-prose li { margin-bottom: var(--space-2); padding-left: .15em; }
  .reading-page .reading-prose li::marker { color: var(--color-slate); }
  .reading-page .reading-prose blockquote { margin: var(--space-6) 0; padding-left: var(--space-5); border-left: 2px solid var(--color-ink); color: var(--color-ink); font-style: normal; }
  .reading-page .reading-prose :is(img, video, iframe) { max-width: 100%; }
  .reading-page .reading-prose img { display: block; height: auto; margin: var(--space-6) 0; border-radius: var(--radius-media); }
  .reading-page .reading-prose figure { margin: var(--space-6) 0; }
  .reading-page .reading-prose figcaption { margin-top: var(--space-2); font-size: var(--type-meta); line-height: var(--leading-meta); color: var(--color-slate); }
  .reading-page .reading-prose table { display: block; width: 100%; max-width: 100%; overflow-x: auto; border-collapse: collapse; margin: var(--space-6) 0; font-size: var(--type-small); line-height: var(--leading-small); }
  .reading-page .reading-prose :is(th, td) { padding: var(--space-3) var(--space-4); border-bottom: var(--border-hairline); text-align: left; }
  .reading-page .reading-prose th { color: var(--color-ink); font-weight: var(--weight-medium); }
  .reading-page .reading-prose :not(pre) > code { padding: .15em .35em; border-radius: 4px; background: var(--color-panel); color: var(--color-ink); font-family: var(--font-mono); font-size: .85em; }
  .reading-page .reading-prose hr { margin: var(--space-8) 0; border: 0; border-top: var(--border-hairline); }

  @media (max-width: 809px) {
    .reading-page { padding-top: var(--space-6); }
    .reading-head h1 { font-size: var(--type-display-phone); line-height: var(--leading-display-phone); letter-spacing: -.6px; }
    .reading-description { font-size: var(--type-lede); line-height: var(--leading-lede); }
    .reading-page .reading-prose { font-size: var(--type-body); line-height: var(--leading-body); }
    .reading-page .reading-prose :is(h1, h2) { font-size: 24px; line-height: 30px; }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-reading-link]')];
  const headings = [...document.querySelectorAll<HTMLElement>('.reading-prose :is(h1,h2,h3,h4,h5,h6)[id]')];
  if (links.length && headings.length) {
    let pending = false;
    const update = () => {
      const current = headings.filter((heading) => heading.getBoundingClientRect().top <= 150).at(-1) ?? headings[0];
      links.forEach((link) => {
        if (decodeURIComponent(link.hash.slice(1)) === current.id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      pending = false;
    };
    window.addEventListener('scroll', () => {
      if (!pending) { pending = true; requestAnimationFrame(update); }
    }, {passive: true});
    update();
  }
</script>
