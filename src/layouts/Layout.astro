---
import '~/assets/styles/tailwind.css';
import 'highlight.js/styles/github-dark.css';
import '~/styles/post-render.css';

import {I18N} from 'samperalabs:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import Metadata from '~/components/common/Metadata.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

import type {MetaData as MetaDataType} from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const {metadata = {}} = Astro.props;
const {language, textDirection} = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    <Metadata {...metadata} />

    <style is:global>
      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        padding: 0;
        font-feature-settings:
          'calt' 1,
          'kern' 1;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      img {
        content-visibility: auto;
      }
    </style>
  </head>

  <body class="bg-stone-50 text-stone-900 font-sans antialiased min-h-screen">
    <slot />
    <BasicScripts />
    <script>
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (!t || !t.matches('button[data-copy]')) return;
        const wrap = t.closest('.codewrap');
        const code = wrap?.querySelector('pre code');
        if (!code) return;
        navigator.clipboard.writeText(code.textContent ?? '').then(() => {
          const prev = t.textContent;
          t.textContent = 'copied';
          setTimeout(() => { t.textContent = prev; }, 1200);
        });
      });
    </script>
  </body>
</html>
