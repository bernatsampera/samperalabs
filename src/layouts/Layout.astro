---
import '~/assets/styles/tailwind.css';
import '@fontsource-variable/geist/wght.css';
import 'highlight.js/styles/github-dark.css';
import '~/assets/styles/tokens.css';
import '~/assets/styles/site.css';
import '~/styles/post-render.css';
import '~/styles/code-block.css';

import {I18N} from 'samperalabs:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import Metadata from '~/components/common/Metadata.astro';

import type {MetaData as MetaDataType} from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const {metadata = {}} = Astro.props;
const {language, textDirection} = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection}>
  <head>
    <CommonMeta />
    <Favicons />
    <Metadata {...metadata} />
  </head>

  <body>
    <slot />
    <script>
      document.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (!t || !t.matches('button[data-copy]')) return;
        const wrap = t.closest('.codewrap');
        const code = wrap?.querySelector('pre code');
        if (!code) return;
        navigator.clipboard.writeText(code.textContent ?? '').then(() => {
          const prev = t.textContent;
          t.textContent = 'copied';
          setTimeout(() => { t.textContent = prev; }, 1200);
        });
      });
    </script>
  </body>
</html>
