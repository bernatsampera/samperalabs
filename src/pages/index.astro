---
import {getImage} from 'astro:assets';
import PageLayout from '~/layouts/PageLayout.astro';
import Header from '~/components/elements/Header.astro';
import Footer from '~/components/elements/Footer.astro';
import StorySection from '~/components/story/StorySection.astro';
import AskJev from '~/components/ask/AskJev.astro';
import {blockHtml} from '~/components/ask/render';
import {PROJECT_CARDS} from '~/lib/ask/content';
import '~/components/ask/project-card.css';
import {stories} from '~/lib/stories';
import profile from '~/assets/images/profile.jpeg';

// Approved design: design-preview/design-system/clean/index.html. Rules: design-preview/design-system/DESIGN.md.
const avatar = await getImage({src: profile, width: 160, format: 'webp'});
const metadata = {title: 'Bernat Sampera', description: 'AI engineer. Everything is information. How a company becomes AI native, and how AI should store and find information.'};
---

<PageLayout metadata={metadata}>
  <Header slot="header" overlay />

  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- Ask Jev: the question box is the hero. Answers appear above the field. -->
  <AskJev />

  {stories.map((story, i) => <StorySection story={story} id={i === 0 ? 'work' : story.slug} />)}

  <section class="night" id="side-projects" aria-labelledby="side-title">
    <div class="col">
      <div class="night-head" data-appear>
        <h2 id="side-title">Also built<span>Two side projects</span></h2>
      </div>
      <!-- The same project cards as the Ask answers (src/components/ask/project-card.css). -->
      <div class="side-cards on-night" data-appear set:html={blockHtml({kind: 'cards', cards: [PROJECT_CARDS.bjjgym, PROJECT_CARDS.indoeuromap]}, 'home')} />
    </div>
    <Footer tone="night" topId="hero-title" />
  </section>

  <Fragment slot="footer" />
</PageLayout>

<script>
  const io = new IntersectionObserver((entries) => entries.forEach((e) => {
    if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }), {rootMargin: '0px 0px -10% 0px'});
  document.querySelectorAll('[data-appear]').forEach((el) => io.observe(el));
</script>

<style>
  /* Hero: centered, as in the reference. */
  .hero { height: 100svh; min-height: 640px; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; text-align: center; }
  .hero h1 { margin: 0; max-width: 660px; font-size: var(--type-display); line-height: var(--leading-display); letter-spacing: var(--tracking-display); font-weight: var(--weight-medium); }
  .greet { display: flex; justify-content: center; align-items: center; gap: var(--space-4); color: var(--color-faint); }
  .role { display: block; }
  .avatar { display: inline-block; flex: none; width: 72px; height: 48px; border-radius: 24px; background: var(--color-night) center 30% / cover no-repeat; filter: grayscale(1); }
  .me-sm, .hero-links { display: none; }
  .cue-wrap { position: absolute; left: 0; right: 0; bottom: var(--space-6); display: flex; justify-content: center; }
  .cue { display: flex; flex-direction: column; align-items: center; gap: var(--space-1); color: var(--color-ink); text-decoration: none; }
  .cue .ico { width: 10px; height: 10px; }

  /* Night: the one dark section. */
  .night { background: var(--color-night); color: var(--color-night-text); }
  .night-head { padding: var(--space-10) 0 var(--space-7); }
  .night-head h2 { margin: 0; font-size: var(--type-display); line-height: var(--leading-display); letter-spacing: var(--tracking-display); font-weight: var(--weight-medium); }
  .night-head h2 span { display: block; color: var(--color-night-soft); }
  .side { display: flex; flex-direction: column; gap: var(--space-5); padding-bottom: var(--space-10); }
  .side a { display: flex; flex-direction: column; justify-content: flex-end; gap: var(--space-3); min-height: 320px; padding: var(--space-6); border-radius: var(--radius-media); background: var(--color-night-raise); color: inherit; text-decoration: none; transition: background-color var(--dur-hover); }
  .side a:hover { background: #26262A; }
  .side h3 { margin: 0; font-size: var(--type-section); line-height: var(--leading-section); letter-spacing: var(--tracking-section); font-weight: var(--weight-medium); }
  .side p { margin: 0; color: var(--color-night-soft); }
  .side .link { margin-top: var(--space-2); color: var(--color-accent-night); }
  .night :focus-visible { outline-color: var(--color-night-text); }
  .side-cards { padding-bottom: var(--space-10); }

  @media (max-width: 809px) {
    .hero { height: auto; min-height: 0; padding: var(--space-6) 0 var(--space-9); text-align: left; align-items: stretch; }
    .hero h1 { max-width: none; font-size: var(--type-display-phone); line-height: var(--leading-display-phone); }
    .me-sm { display: block; width: 48px; height: 48px; margin-bottom: var(--space-6); border-radius: 50%; background: var(--color-night) center 30% / cover no-repeat; filter: grayscale(1); }
    .greet { justify-content: flex-start; }
    .greet .avatar { display: none; }
    .hero-links { display: flex; align-items: center; gap: var(--space-6); margin-top: var(--space-6); }
    .hero-links a, .hero-links button { padding: 0; border: 0; background: none; color: var(--color-ink); font: inherit; text-decoration: none; cursor: pointer; }
    .cue-wrap { display: none; }
    .side h3 { font-size: var(--type-section-phone); line-height: var(--leading-section-phone); }
    .night-head { padding: var(--space-9) 0 var(--space-6); }
    .night-head h2 { font-size: var(--type-display-phone); line-height: var(--leading-display-phone); }
    .side a { min-height: 240px; padding: var(--space-5); }
  }
</style>
