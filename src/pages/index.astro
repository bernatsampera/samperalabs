---
import PageLayout from '../layouts/PageLayout.astro';
import ProjectList from '../components/common/ProjectList.astro';
import PostSection from '../components/home/PostSection.astro';
import {getPublicPostStore} from '../lib/publicPostStore';
import type {EnhancedPost} from '../lib/db';
import '../assets/styles/home.css';
import '../assets/styles/content-shell.css';

const featuredSlugs = ['gym-schedule-image-to-classes', 'building-an-ai-brain-at-maat', 'context-tree-agent-support-tasks', 'express-the-general', 'your-ai-agent-deserves-its-own-repo', 'lessons-learned-building-a-real-world-ai-agent-with-langgraph', 'analyzing-open-deep-research'];
const allPosts = await getPublicPostStore().getAllPosts();
const postsBySlug = new Map(allPosts.map(post => [post.slug, post]));
function groupPosts(posts: EnhancedPost[]) {
  const years = new Map<number, Map<number, EnhancedPost[]>>();
  for (const post of posts) {
    const date = new Date(post.pub_date);
    const year = date.getUTCFullYear(), month = date.getUTCMonth();
    if (!years.has(year)) years.set(year, new Map());
    const months = years.get(year)!;
    if (!months.has(month)) months.set(month, []);
    months.get(month)!.push(post);
  }
  return [...years].sort(([a],[b]) => b-a).map(([year, months]) => ({year, months:[...months].sort(([a],[b]) => b-a).map(([month,posts]) => ({name:new Date(Date.UTC(2000,month,1)).toLocaleDateString('en-GB',{month:'long',timeZone:'UTC'}),posts}))}));
}
const essays = featuredSlugs.map(slug => postsBySlug.get(slug)).filter((post): post is NonNullable<typeof post> => Boolean(post));
const metadata = {title: 'Bernat Sampera', description: 'AI engineer. Projects and notes from building AI systems.'};
---
<PageLayout metadata={metadata}>
  <div class="home-notebook content-shell content-shell-grid" id="home-top">
    <a class="home-skip" href="#writing">Skip to writing</a>
    <aside class="home-rail" aria-label="Page navigation">
      <details class="home-index" id="all-posts" open>
        <summary>Posts</summary>
        <nav class="home-contents" aria-label="Posts by year and month">
          {groupPosts(essays).map(group => <section class="rail-year"><h2>{group.year}</h2>{group.months.map(month => <section class="rail-month"><h3>{month.name}</h3>{month.posts.map(post => <a href={`#essay-${post.slug}`} data-home-link>{post.title}</a>)}</section>)}</section>)}
        </nav>
      </details>
    </aside>
    <div class="home-body">
      <h1 class="sr-only">Writing on AI.</h1>
      <div id="writing" class="writing-sections">
        {essays.map((post,index) => <PostSection post={post} index={index} />)}
      </div>
    </div>
  </div>
  <div id="work" class="home-work content-shell"><ProjectList /></div>
</PageLayout>
<script>import '../scripts/home';</script>
