---
import PageLayout from '../layouts/PageLayout.astro';
import '../assets/styles/content-shell.css';

const metadata = {
  title: 'About & contact',
  description: 'Bernat Sampera, AI engineer building production agents and working on the context layer.',
};
---

<PageLayout metadata={metadata}>
  <div class="about-page content-shell">
    <article class="about-copy">
      <h1>Bernat Sampera</h1>
      <p>I'm Bernat, an AI engineer. I build AI products and agents that run in production.</p>
      <p>Recently, most of my work has been around the context layer: how to structure information so an agent can find it, use it, and keep useful knowledge between sessions.</p>
      <p>The idea is to build maps of knowledge, with facts, procedures, and relationships between them. A tree is one way to organize this, but the structure is only part of the problem. There's also what to load for each task, what to keep after it, and when that information needs to change.</p>
      <p>I build and test different approaches to this, alongside the products where they get used.</p>
      <section class="about-contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Contact</h2>
        <a href="mailto:info@samperalabs.com">info@samperalabs.com</a>
        <a href="https://x.com/bsampera97" target="_blank" rel="noopener noreferrer" aria-label="X: @bsampera97 (opens in a new tab)">X: @bsampera97</a>
        <a href="https://www.linkedin.com/in/bernat-sampera-195152107/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn: Bernat Sampera (opens in a new tab)">LinkedIn: Bernat Sampera</a>
      </section>
    </article>
  </div>
</PageLayout>

<style>
  .about-page { padding-block: clamp(48px, 7vw, 96px); }
  .about-copy { max-width: 690px; margin-inline: auto; color: #27272a; }
  h1 { font-size: clamp(32px, 4vw, 44px); line-height: 1.2; font-weight: 600; letter-spacing: -.035em; margin: 0 0 40px; }
  p { font-size: 17px; line-height: 1.85; margin: 0 0 24px; }
  .about-contact { margin-top: 48px; padding-top: 28px; border-top: 1px solid #d4d4d8; }
  h2 { font-size: 20px; font-weight: 500; margin: 0 0 12px; }
  a { display: table; min-height: 44px; padding-block: 10px; font-size: 15px; text-decoration: underline; text-underline-offset: 5px; overflow-wrap: anywhere; }
  a:hover { color: #52525b; }
  a:focus-visible { outline: 2px solid #18181b; outline-offset: 4px; }
</style>
