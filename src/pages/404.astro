---
import PageLayout from '../layouts/PageLayout.astro';

const metadata = {
  title: 'Page Not Found',
};
---

<PageLayout metadata={metadata}>
  <div class="missing col">
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist.</p>
    <a class="link" href="/">Go home<svg class="ico" viewBox="0 0 12 12" aria-hidden="true"><path d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
  </div>
</PageLayout>

<style>
  .missing { padding-top: var(--space-10); }
  h1 { margin: 0 0 var(--space-3); font-size: var(--type-title); line-height: var(--leading-title); letter-spacing: var(--tracking-title); font-weight: var(--weight-medium); }
  p { margin: 0 0 var(--space-5); font-size: var(--type-lede); line-height: var(--leading-lede); color: var(--color-graphite); }
</style>
