---
// The home hero: the portrait you fly into. It sits in the Ask Jev landing view (AskJev slot "hello"),
// under the production dock. The approved information sequence uses non-clickable pieces.
// The shared site header sits above the portrait.
import '@fontsource/instrument-serif/400-italic.css';
import portrait from './portrait.jpg';
import { portfolioCards } from './information-panels.js';
const pieces = portfolioCards();
---
<div class="flight" data-flight data-photo={portrait.src}>
  <div class="flight-figure" data-flight-figure role="img" aria-label="A portrait of Bernat made of thousands of dots. Scroll through four pieces about information and AI agents.">
    <p class="flight-fail" data-fail>This browser cannot draw the portrait (WebGL is off).</p>

  </div>
  <div class="flight-reading" data-reading>
    {pieces.map(piece => <section><h2>{piece.title}</h2><p>{piece.detail}</p></section>)}
  </div>
  <div class="flight-intro">
    <h1 class="flight-name" id="hero-title"><span class="flight-name-text"><span>Bernat</span> <span>Sampera</span></span></h1>
  </div>
</div>

<noscript>
  <style is:inline>
    .flight .flight-reading { display: block; }
    .flight .flight-figure, .flight .flight-intro { display: none; }
  </style>
</noscript>

<script>
  import * as THREE from 'three';
  import { startFlight } from './information-flight.js';
  import { portfolioCards, drawPortfolioPanel } from './information-panels.js';

  const stage = document.querySelector<HTMLElement>('[data-flight]');
  const root = stage?.closest<HTMLElement>('[data-ask]');
  if (stage && root) {
    // The name fills a third of the width on a desktop, most of it on a phone, in two lines.
    const measure = document.createElement('span');
    measure.className = 'flight-name-measure'; measure.textContent = 'Sampera'; stage.append(measure);
    const fitName = () => {
      const phone = matchMedia('(max-width: 809px)').matches;
      const w = measure.getBoundingClientRect().width || 1;
      const target = phone ? stage.clientWidth - 48 : stage.clientWidth * 0.34;
      const cap = innerHeight * (phone ? 0.1 : 0.17);
      stage.style.setProperty('--name-size', Math.max(40, Math.min((100 * target) / w, cap)).toFixed(1) + 'px');
    };
    fitName(); addEventListener('resize', fitName);

    const img = new Image();
    img.onload = async () => {
      await Promise.all([400, 700].map((w) => document.fonts.load(`${w} 38px "Geist Variable"`))).catch(() => {});
      await document.fonts.load('italic 100px "Instrument Serif"').catch(() => {});
      fitName();
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) { stage.classList.add('reading'); return; }
      try {
        const pieces = portfolioCards();
        const images = {};
        await Promise.all(['context', 'structure', 'maintaining'].map(async name => {
          const image = new Image(); image.src = '/images/portrait-' + name + '.webp';
          await image.decode(); images[name] = image;
        }));
        pieces.forEach(piece => { piece.art = drawPortfolioPanel(piece, images); piece.size = 1.2; });
        const content = { pieces: { knowledge: pieces }, story: pieces.map((_, i) => 'knowledge:' + i), regions: [], skin: 'knowledge', laneOnly: true };
        startFlight(THREE, { root, stage, photo: img, content });
        stage.classList.add('ready');
      } catch (e) { stage.classList.add('reading'); console.error(e); }
    };
    img.onerror = () => stage.classList.add('reading');
    img.src = stage.dataset.photo!;
  }
</script>

<style is:global>
  .flight-reading { display:none; position:absolute; inset:120px 24px 190px; overflow:auto; max-width:680px; margin:auto; padding:24px; background:var(--color-paper); z-index:3; }
  .flight.reading .flight-reading { display:block; }
  .flight-reading section { margin-bottom:32px; }
  .flight-reading h2 { font:700 32px/1.1 var(--font-sans); margin-bottom:12px; }
  .flight-reading p { font:400 18px/1.5 var(--font-sans); }
  .flight.ready .flight-reading { display:block; position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); }
  .flight.reading .flight-figure,.flight.reading .flight-intro { display:none; }
  @media(max-width:809px){.flight-reading{inset:85px 12px 180px;padding:16px;}}

  /* The stage covers the landing view; the dock (chips and field) stays above it. */
  .flight { --name-size: 150px; position: absolute; inset: 0; overflow: hidden; }
  .flight-figure { position: absolute; inset: 0; }
  .flight-figure canvas.face { position: absolute; inset: 0; display: block; width: 100% !important; height: 100% !important; cursor: default; touch-action: pan-y; }
  .flight-fail { position: absolute; inset: 0; display: none; place-items: center; padding: var(--space-6); color: var(--color-slate); font-size: var(--type-small); text-align: center; }

  .flight-intro { position: absolute; left: max(var(--space-5), calc((100vw - 1392px) / 2 + var(--space-5))); top: var(--space-7); z-index: 2; display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); pointer-events: none; background: var(--color-paper); box-shadow: 0 0 28px 20px var(--color-paper); border-radius: 4px; }
  .flight-name { margin: 0; font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; font-size: var(--name-size); line-height: .9; letter-spacing: -.01em; color: var(--color-ink); text-align: left; white-space: nowrap; }
  .flight-name-text > span { display: block; }
  .flight-name-measure { position: absolute; left: 0; top: 0; visibility: hidden; white-space: nowrap; font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-size: 100px; line-height: 1; letter-spacing: -.01em; pointer-events: none; }
  .flight-hint { margin: 0; font-size: var(--type-ui); line-height: var(--leading-ui); color: var(--color-slate); }
  /* flying: the name and the hint leave, so the field has the whole screen; "Back to the face" stays */
  .flight-name, .flight-hint { transition: opacity 360ms var(--ease-out), visibility 360ms; }
  .flight.in .flight-name, .flight.in .flight-hint { opacity: 0; visibility: hidden; }
  .flight.in .flight-intro { background: none; box-shadow: none; }
  .flight.in .flight-back { position: absolute; top: 0; left: 0; }


  .flight-back { height: 32px; padding: 0 var(--space-3); font-size: var(--type-small); pointer-events: auto; }


  @media (max-width: 809px) {
    .flight-intro { top: var(--space-5); max-width: calc(100vw - 2 * var(--space-5)); gap: var(--space-2); }
  }
</style>
