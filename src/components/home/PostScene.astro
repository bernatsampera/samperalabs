---
import type { PostPresentation } from '../../lib/postPresentation';
import BrainScene from './BrainScene.astro';
import ScheduleScene from './ScheduleScene.astro';
interface Props {
  presentation: PostPresentation;
  id: string;
}
const { presentation, id } = Astro.props;
---

<figure class:list={['home-scene', `home-scene-${presentation.scene}`]} data-home-scene>
  {presentation.scene === 'shared-brain' && <BrainScene id={id} />}
  {presentation.scene === 'schedule-import' && <ScheduleScene id={id} />}
  {presentation.scene === 'schedule-import' && <figcaption class="schedule-scene-caption">{presentation.caption}</figcaption>}
  {
    presentation.scene === 'translation-loop' && (
      <svg viewBox="0 0 600 420" role="img" aria-labelledby={`${id}-scene-title ${id}-scene-desc`}>
        <title id={`${id}-scene-title`}>A translation changes after feedback</title>
        <desc id={`${id}-scene-desc`}>
          Illustrative wording: a literal translation, “Make a photo,” changes to “Take a photo.” A separate background
          task proposes a glossary entry for review.
        </desc>
        <text x="30" y="42" class="scene-note">
          AN EDIT IN PROGRESS
        </text>
        <text x="30" y="99" class="scene-label">
          Example source: “Hacer una foto”
        </text>
        <text x="30" y="190" class="scene-display">
          Make a photo.
        </text>
        <path
          d="M27 173L192 163"
          class="scene-pen"
          pathLength="1"
          stroke-dasharray="1"
          data-motion="draw"
          data-start="0.12"
          data-end="0.3"
        />
        <g data-motion="reveal" data-start="0.3" data-end="0.52" data-y="16">
          <text x="34" y="253" class="scene-correction">
            Take
          </text>
          <path d="M86 214L96 193L106 208" class="scene-pen" />
          <text x="183" y="249" class="scene-label">
            Apply the user's correction.
          </text>
        </g>
        <g data-motion="reveal" data-start="0.68" data-end="0.95" data-x="28">
          <path d="M30 309H570" class="scene-rule" />
          <text x="30" y="340" class="scene-note">
            SEPARATE BACKGROUND TASK
          </text>
          <text x="30" y="371" class="scene-label">
            Suggest “take a photo” for the glossary.
          </text>
          <text x="30" y="397" class="scene-small">
            A proposal for review, not an automatic change.
          </text>
        </g>
      </svg>
    )
  }
  {
    presentation.scene === 'context-tree' && (
      <svg viewBox="0 0 600 420" role="img" aria-labelledby={`${id}-scene-title ${id}-scene-desc`}>
        <title id={`${id}-scene-title`}>An investigation follows a written procedure</title>
        <desc id={`${id}-scene-desc`}>
          An illustrative support document connects a membership question to service references, a runbook, and an
          investigation log. Annotations identify where to look and what to retain.
        </desc>
        <path d="M37 24L395 33L388 394L28 385Z" fill="white" stroke="#a1a1aa" />
        <text x="61" y="65" class="scene-small">
          SUPPORT / INVESTIGATION
        </text>
        <text x="61" y="111" class="scene-document-title">
          Membership mismatch
        </text>
        <path d="M61 128H356" class="scene-rule" />
        <text x="61" y="166" class="scene-label">
          01 Open the support index
        </text>
        <text x="61" y="219" class="scene-label">
          02 Read the runbook
        </text>
        <text x="61" y="272" class="scene-label">
          03 Check service details
        </text>
        <text x="61" y="325" class="scene-label">
          04 Keep an investigation log
        </text>
        <text x="61" y="365" class="scene-small">
          Illustrative procedure
        </text>
        <g data-motion="reveal" data-start="0.08" data-end="0.3" data-x="-14">
          <path d="M255 225Q405 248 420 176" class="scene-pen" />
          <text x="417" y="137" class="scene-annotation">
            Where
          </text>
          <text x="417" y="163" class="scene-annotation">
            to look
          </text>
        </g>
        <path
          d="M91 281Q206 289 331 279"
          class="scene-pen"
          pathLength="1"
          stroke-dasharray="1"
          data-motion="draw"
          data-start="0.32"
          data-end="0.56"
        />
        <g data-motion="reveal" data-start="0.58" data-end="0.88" data-y="12">
          <path d="M312 332Q401 372 426 308" class="scene-pen" />
          <text x="417" y="264" class="scene-annotation">
            What to
          </text>
          <text x="417" y="290" class="scene-annotation">
            retain
          </text>
        </g>
      </svg>
    )
  }
  {
    presentation.scene === 'context-repo' && (
      <svg viewBox="0 0 600 420" role="img" aria-labelledby={`${id}-scene-title ${id}-scene-desc`}>
        <title id={`${id}-scene-title`}>Sessions change. Reference files remain.</title>
        <desc id={`${id}-scene-desc`}>
          A permanent context document stays in place while one session leaves and another arrives. Each session loads
          the files needed for its task. The example does not imply automatic memory.
        </desc>
        <text x="30" y="42" class="scene-note">
          KEEP THE KNOWLEDGE
        </text>
        <path d="M43 101L272 84L289 337L60 353Z" fill="#e4e4e7" />
        <path d="M40 83H274V330H40Z" fill="white" stroke="#71717a" />
        <text x="62" y="126" class="scene-document-title">
          context/
        </text>
        <path d="M62 145H249" class="scene-rule" />
        <text x="62" y="185" class="scene-label">
          Service knowledge
        </text>
        <text x="62" y="226" class="scene-label">
          Procedures
        </text>
        <text x="62" y="267" class="scene-label">
          Active tasks
        </text>
        <text x="62" y="308" class="scene-small">
          Version-controlled files
        </text>
        <path d="M303 91V331" class="scene-rule" stroke-dasharray="3 7" />
        <g data-motion="leave" data-start="0.2" data-end="0.47" data-y="-42">
          <text x="336" y="137" class="scene-small">
            SESSION 01
          </text>
          <text x="336" y="185" class="scene-session">
            Investigate
          </text>
          <text x="336" y="220" class="scene-session">
            a membership.
          </text>
          <text x="336" y="271" class="scene-label">
            Load relevant files.
          </text>
        </g>
        <g data-motion="reveal" data-start="0.51" data-end="0.8" data-y="42">
          <text x="336" y="137" class="scene-small">
            SESSION 02
          </text>
          <text x="336" y="185" class="scene-session">
            Check
          </text>
          <text x="336" y="220" class="scene-session">
            an export.
          </text>
          <text x="336" y="271" class="scene-label">
            Reuse relevant files.
          </text>
        </g>
        <text x="40" y="390" class="scene-label">
          New task. The reference stays.
        </text>
      </svg>
    )
  }
</figure>
