---
interface Props {
  id: string;
}
const { id } = Astro.props;
---

<svg viewBox="0 0 600 420" role="img" aria-labelledby={`${id}-scene-title ${id}-scene-desc`}>
  <title id={`${id}-scene-title`}>People and AI use one shared handbook</title>
  <desc id={`${id}-scene-desc`}
    >A central open handbook contains an index and approved procedures. Three readers consult the same reference. Shared
    knowledge does not change access rules.</desc
  >
  <text x="300" y="35" text-anchor="middle" class="scene-note">ONE REFERENCE. SEVERAL READERS.</text>
  <g fill="none" stroke="#a1a1aa" stroke-width="1.5">
    <path d="M118 124Q170 119 210 176" pathLength="1" data-motion="draw" data-start="0.08" data-end="0.3"></path>
    <path d="M490 147Q449 150 404 187" pathLength="1" data-motion="draw" data-start="0.35" data-end="0.58"></path>
    <path d="M307 341V294" pathLength="1" data-motion="draw" data-start="0.63" data-end="0.86"></path>
  </g>
  <g class="scene-reader" data-motion="reveal" data-start="0" data-end="0.18" data-x="-18">
    <circle cx="99" cy="91" r="19"></circle><path d="M61 148Q64 118 99 117Q134 118 137 148Z"></path>
    <text x="99" y="174" text-anchor="middle" class="scene-small">Support</text>
  </g>
  <g class="scene-reader" data-motion="reveal" data-start="0.28" data-end="0.46" data-x="18">
    <circle cx="503" cy="111" r="19"></circle><path d="M465 168Q468 138 503 137Q538 138 541 168Z"></path>
    <text x="503" y="194" text-anchor="middle" class="scene-small">Engineering</text>
  </g>
  <path d="M157 164Q227 145 300 170Q373 145 443 164L435 289Q367 275 300 298Q233 275 165 289Z" fill="#e4e4e7"></path>
  <path
    d="M151 154Q227 135 300 160Q373 135 449 154L438 278Q367 264 300 287Q233 264 162 278Z"
    fill="white"
    stroke="#52525b"
    stroke-width="1.5"></path>
  <path d="M300 160V287" class="scene-rule"></path>
  <text x="180" y="195" class="scene-document-title">Index</text>
  <text x="319" y="195" class="scene-label">Approved</text>
  <text x="319" y="222" class="scene-label">procedures</text>
  <path d="M181 220H270M181 237H257M181 254H268M320 243H418M320 257H402" class="scene-rule"></path>
  <g class="scene-reader" data-motion="reveal" data-start="0.56" data-end="0.76" data-y="16">
    <circle cx="307" cy="333" r="16"></circle><path d="M277 378Q280 354 307 354Q334 354 337 378Z"></path>
    <text x="357" y="366" class="scene-label">AI assistance</text>
  </g>
  <text x="300" y="410" text-anchor="middle" class="scene-small">Illustrative scene. Access rules still apply.</text>
</svg>
