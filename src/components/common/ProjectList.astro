---
import type {EnhancedPost} from '../../lib/db';

export interface Props {
  projects: EnhancedPost[];
}

const {projects} = Astro.props;
---

<section class="mx-auto max-w-[44rem] px-5 sm:px-8 pb-16">
  <h3 class="text-[14px] font-semibold text-stone-900 pt-8 sm:pt-10 pb-3 sm:pb-4">
    Projects
  </h3>
  <ul class="border-t border-stone-100/80">
    {projects.map((project) => (
      <li class="border-b border-stone-100/80">
        <a
          href={`/posts/${project.slug}`}
          class="group block py-3 sm:py-2.5"
        >
          <h2 class="text-[16px] text-stone-900 group-hover:text-stone-600 transition-colors">
            {project.title}
          </h2>
          {project.description && (
            <p class="text-[14px] text-stone-500 mt-1">
              {project.description}
            </p>
          )}
        </a>
      </li>
    ))}
  </ul>
</section>
