---
import {selectedProjects} from '../../lib/projects';
---

<section class="selected-projects" aria-label="Selected projects">
  <div class="project-track" id="project-track" tabindex="0" role="region" aria-label="Project slider">
  {selectedProjects.map((project) => (
    <article class="project" id={project.slug} aria-labelledby={`${project.slug}-title`}>
      <div class="project-grid">
        <div class="project-copy">
          <h2 id={`${project.slug}-title`}>{project.name}</h2>
          <a class="visit" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.name} (opens in a new tab)`}>{new URL(project.url).hostname} <span aria-hidden="true">↗</span></a>
          <p class="purpose">{project.purpose}</p>
          <p class="description">{project.description}</p>
          <dl>
            <div><dt>Problem</dt><dd>{project.problem}</dd></div>
            <div><dt>Solution</dt><dd>{project.solution}</dd></div>
          </dl>
        </div>
        <figure class="project-visual">
          {project.slug === 'bjjgym' ? <>
            <blockquote>“Dropped in for <mark>no-gi</mark>. <mark>Clean mats</mark>, a coach who <mark>explained every step</mark>, and <mark>tough rounds</mark>.”</blockquote>
            <div class="review-labels"><span>No-gi</span><span>Clean</span><span>Good teacher</span><span>High level</span></div>
            <figcaption>Example review and labels.</figcaption>
          </> : project.slug === 'indoeuromap' ? <>
            <svg class="area-map" viewBox="0 0 360 235" role="img" aria-label="Illustrative map with connected area profiles">
              <g stroke="white" stroke-width="6" stroke-linejoin="round">
                <path d="M25 60 110 24 167 74 145 145 48 140Z" fill="#dedede" />
                <path d="M110 24 253 20 232 101 167 74Z" fill="#bdbdbd" />
                <path d="M253 20 336 62 311 163 232 101Z" fill="#e6e6e6" />
                <path d="M48 140 145 145 183 212 83 221 20 185Z" fill="#d1d1d1" />
                <path d="M167 74 232 101 311 163 263 219 183 212 145 145Z" fill="#999" />
              </g>
              <path d="M95 98 197 58 228 163" fill="none" stroke="#333" stroke-dasharray="4 5" />
              <g fill="white" stroke="#333" stroke-width="2"><circle cx="95" cy="98" r="6" /><circle cx="197" cy="58" r="6" /><circle cx="228" cy="163" r="6" /></g>
            </svg>
            <figcaption>Illustrative map.</figcaption>
          </> : <>
            <p class="context-line">The task ends.<br />Keep the useful context.</p>
            <div class="context-files"><span><b>01</b> Decisions <small>saved</small></span><span><b>02</b> Procedures <small>reusable</small></span><span><b>03</b> Connections <small>available</small></span></div>
            <p class="context-result">Ready for the next session.</p>
            <figcaption>Example context structure.</figcaption>
          </>}
        </figure>
      </div>
    </article>
  ))}
  </div>
  <div class="slider-controls" hidden><button type="button" data-project-prev aria-label="Previous project" aria-controls="project-track">Previous</button><button type="button" data-project-next aria-label="Next project" aria-controls="project-track">Next</button></div>
</section>

<style>
.selected-projects{color:#18181b;padding:0}.project-track{display:flex;gap:64px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#71717a #e4e4e7;padding:0 0 24px;overscroll-behavior-x:contain;align-items:stretch}
.project{flex:0 0 91%;min-width:0;scroll-snap-align:start;padding:32px 0;scroll-margin-top:100px}
.project-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(32px,5vw,88px);align-items:center}.project-copy{min-width:0}h2{font-size:clamp(40px,5vw,76px);line-height:1.05;font-weight:650;letter-spacing:-.065em;margin:0;overflow-wrap:anywhere}.visit{display:inline-flex;gap:12px;align-items:center;min-height:44px;margin-top:10px;font-size:15px;color:#52525b;text-decoration:underline;text-underline-offset:5px}.visit:hover{color:#18181b}.purpose{max-width:18em;font-size:clamp(24px,2.2vw,32px);letter-spacing:-.03em;line-height:1.2;margin:28px 0 16px}.description,dd{font-size:15px;line-height:1.7;color:#3f3f46}.description{max-width:38em}dl{margin-top:28px;display:grid;gap:18px;max-width:40em}dt{font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;margin-bottom:5px}dd{margin:0}
.project-visual{display:flex;flex-direction:column;justify-content:center;min-height:440px;margin:0;padding:clamp(24px,4vw,64px);background:#18181b;color:#fafafa}blockquote{margin:0 0 32px;font:clamp(22px,2.3vw,34px)/1.5 Georgia,serif}mark{background:#3f3f46;color:#fafafa;padding:0 3px}.review-labels{display:flex;gap:8px;flex-wrap:wrap}.review-labels span{padding:8px 12px;background:#3f3f46;color:#fafafa;font-size:12px}figcaption{font-size:12px;line-height:1.5;color:#a1a1aa;margin-top:28px}.area-map{width:100%;height:auto;max-height:300px;display:block}.context-line{margin:0 0 28px;font-size:clamp(24px,2.5vw,36px);letter-spacing:-.04em;line-height:1.2}.context-files{display:grid}.context-files>span{border-bottom:1px solid #52525b;padding:16px 0;display:flex;gap:12px;align-items:baseline;font-size:15px}.context-files b{font:12px monospace;color:#a1a1aa}.context-files small{margin-left:auto;font-size:12px;color:#a1a1aa}.context-result{font-size:14px;margin-top:20px}
.slider-controls{display:flex;justify-content:flex-end;gap:12px;margin-top:12px}.slider-controls[hidden]{display:none}.slider-controls button{min-width:88px;min-height:44px;padding:10px 16px;border:1px solid #71717a;border-radius:4px;background:#fff;color:#18181b;font-size:13px;cursor:pointer}.slider-controls button:hover:enabled{background:#18181b;color:#fff}.slider-controls button:disabled{color:#71717a;border-color:#d4d4d8;cursor:default}.selected-projects :is(a,button,.project-track):focus-visible{outline:2px solid #18181b;outline-offset:3px}
@media(max-width:1000px){.project-grid{grid-template-columns:1fr;gap:32px}.project-track{gap:32px}.project-visual{min-height:360px}.project{flex-basis:90%}}
@media(max-width:700px){.project{flex-basis:92%;padding:20px 0}.project-track{gap:24px}.project-visual{padding:24px;min-height:320px}h2{font-size:40px}.purpose{font-size:26px}}
</style>

<script>
  const track = document.querySelector<HTMLElement>('.project-track');
  if (track) {
    const slides = [...track.querySelectorAll<HTMLElement>('.project')];
    const section = track.closest('.selected-projects')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-project-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-project-next]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    section.querySelector<HTMLElement>('.slider-controls')!.hidden = false;
    function update() {
      const positions = slides.map((slide) => targetPosition(slide));
      current = positions.reduce((best, position, i) => Math.abs(position - track!.scrollLeft) < Math.abs(positions[best] - track!.scrollLeft) ? i : best, 0);
      prev.disabled = track!.scrollLeft <= 2;
      next.disabled = track!.scrollLeft >= track!.scrollWidth - track!.clientWidth - 2;
    }
    function targetPosition(slide: HTMLElement) {
      const target = track!.scrollLeft + slide.getBoundingClientRect().left - track!.getBoundingClientRect().left;
      return Math.max(0, Math.min(target, track!.scrollWidth - track!.clientWidth));
    }
    function go(index: number) {
      const slide = slides[Math.max(0, Math.min(slides.length - 1, index))];
      track!.scrollTo({left: targetPosition(slide), behavior: reduced.matches ? 'instant' : 'smooth'});
    }
    prev.addEventListener('click',()=>go(current-1)); next.addEventListener('click',()=>go(current+1));
    track.addEventListener('scroll',update,{passive:true});window.addEventListener('resize',update);
    track.addEventListener('keydown',event=>{if(event.target!==track)return;if(event.key==='ArrowRight'){event.preventDefault();go(current+1);}if(event.key==='ArrowLeft'){event.preventDefault();go(current-1);}if(event.key==='Home'){event.preventDefault();go(0);}if(event.key==='End'){event.preventDefault();go(slides.length-1);}});
    update();
  }
</script>
