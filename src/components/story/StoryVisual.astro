---
import type {StoryChapter} from '~/lib/stories';
import {storyVisuals} from '~/lib/stories/visuals';

interface Props { chapter: StoryChapter }
const {chapter} = Astro.props;
const image = chapter.detail?.image;
const visual = chapter.visual;
const drawing = visual ? storyVisuals[visual.kind] : undefined;
const isPlaybook = visual?.kind === 'playbook';
---

<figure>
  {image ? <>
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
    <figcaption>{chapter.detail?.caption}</figcaption>
  </> : isPlaybook ? (
    <ol class="playbook-flow">
      {chapter.detail?.flow.map(step => <li>{step}</li>)}
    </ol>
  ) : drawing ? <>
    {visual?.question && <blockquote class="owner-question">{visual.question}</blockquote>}
    <svg
      class:list={['concept-visual', {'answer-visual': visual?.kind === 'answer'}]}
      viewBox={visual?.kind === 'answer' ? '90 94 260 105' : '0 0 360 205'}
      fill="none" stroke="#a2a5af" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
      role="img" aria-label={visual?.label} set:html={drawing}
    />
  </> : (
    <ol class="playbook-flow">
      {chapter.detail?.flow.map(step => <li>{step}</li>)}
    </ol>
  )}
</figure>
