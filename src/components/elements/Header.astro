---
import {getHomePermalink} from '~/utils/permalinks';

export interface Props { isSticky?: boolean; }
const {isSticky = true} = Astro.props;
---

<header class:list={['site-header', {'is-sticky': isSticky}]}>
  <div class="header-inner">
    <a href={getHomePermalink()} class="identity">Bernat Sampera</a>
    <nav class="primary-links" aria-label="Main navigation"><a href="/#writing">Writing</a><a href="/#work">Projects</a><a href="/about" aria-current={Astro.url.pathname === '/about' ? 'page' : undefined}>About &amp; contact</a></nav>
  </div>
</header>

<style>
  .site-header { position: relative; z-index: 40; width: 100%; background: #fff; border-bottom: 1px solid #e6e6e6; color: #171717; }
  .site-header.is-sticky { position: sticky; top: 0; }
  .header-inner { max-width: 1920px; margin: auto; padding: 0 var(--shell-gutter, 40px); min-height: 64px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .identity { font-size: 15px; font-weight: 500; letter-spacing: -.025em; }
  .primary-links { display:flex; gap:24px; margin-left:auto; font-size:13px; }
  a { display: inline-flex; align-items: center; min-height: 44px; }
  a:hover { color: #52525b; }
  a[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
  a:focus-visible { outline: 2px solid #171717; outline-offset: 5px; }
  @media (max-width: 700px) { .header-inner { padding: 0 20px; min-height: 60px; gap:14px; } .identity{font-size:13px;white-space:nowrap} .primary-links{gap:14px;font-size:12px} }
  @media (max-width: 480px) { .header-inner { flex-wrap: wrap; gap: 0; padding-block: 4px; } .primary-links { width: 100%; margin-left: 0; gap: 24px; } }
</style>
