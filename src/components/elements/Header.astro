---
export interface Props {
  /** Home: the nav floats over the hero and hides on phones, where the hero shows its own links. */
  overlay?: boolean;
}
import ContactModal from '../ask/ContactModal.astro';

const {overlay = false} = Astro.props;
const path = Astro.url.pathname;
const current = path === '/' ? 'work' : path.startsWith('/about') ? 'about' : path.startsWith('/posts') || path.startsWith('/writing') ? 'writing' : '';
const links = [
  {id: 'work', label: 'Work', href: '/#work'},
  {id: 'writing', label: 'Writing', href: '/writing'},
  {id: 'about', label: 'About', href: '/about'},
];
---

<header id="top" class:list={['site-nav', {overlay}]}>
  <div class="col">
    <nav class="nav-side" aria-label="Main">
      {links.map((l) => <a class="pill" href={l.href} aria-current={current === l.id ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="nav-side nav-contact">
      <a class="pill" href="https://x.com/bsampera97">X</a>
      <a class="pill" href="https://www.linkedin.com/in/bernat-sampera-195152107/">LinkedIn</a>
      <a class="pill solid" href="mailto:info@samperalabs.com" data-contact-open aria-haspopup="dialog">Email</a>
    </div>
  </div>
</header>

<ContactModal />

<style>
  .site-nav { position: relative; z-index: 5; }
  .site-nav.overlay { position: absolute; top: 0; left: 0; right: 0; }
  .site-nav .col { height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .nav-side { display: flex; align-items: center; gap: var(--space-2); }
  @media (max-width: 809px) {
    .site-nav.overlay { display: none; }
    .nav-contact { display: none; }
    .nav-side { gap: var(--space-1); }
  }
</style>
