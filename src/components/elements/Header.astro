---
import ContactModal from '../ask/ContactModal.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = ['/work', '/maat', '/gcontext'].includes(path) ? 'work'
  : /^\/(writing|posts|notes)(\/|$)/.test(path) ? 'writing'
  : ['/about', '/things-i-like'].includes(path) ? 'about' : '';
const links = [
  {id: 'work', label: 'Work', href: '/work'},
  {id: 'writing', label: 'Writing', href: '/writing'},
  {id: 'about', label: 'About', href: '/about'},
];
---
<header id="top" class="site-nav">
  <div class="col nav-inner">
    <a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}>Bernat Sampera</a>
    <nav class="desktop-nav" aria-label="Main">
      {links.map(l => <a href={l.href} aria-current={current === l.id ? (path === l.href ? 'page' : 'true') : undefined}>{l.label}</a>)}
      <a href="mailto:info@samperalabs.com" data-contact-open aria-haspopup="dialog">Contact</a>
    </nav>
    <details class="mobile-nav" data-site-menu>
      <summary>Menu</summary>
      <nav aria-label="Main">
        {links.map(l => <a href={l.href} aria-current={current === l.id ? (path === l.href ? 'page' : 'true') : undefined}>{l.label}</a>)}
        <a href="mailto:info@samperalabs.com" data-contact-open aria-haspopup="dialog">Contact</a>
      </nav>
    </details>
  </div>
</header>
<ContactModal />
<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-site-menu]');
  if (menu) {
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && menu.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
    });
    document.addEventListener('click', e => {
      const target = e.target as Element;
      if (!menu.contains(target) || target.closest('a')) menu.open = false;
    });
  }
</script>
<style>
  .site-nav { position: sticky; top: 0; z-index: 30; background: var(--color-paper); }
  .nav-inner { height: var(--site-header-h); display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .site-name { font-size: 20px; font-weight: 600; letter-spacing: -.65px; white-space: nowrap; }
  a { color: var(--color-ink); text-decoration: none; }
  nav a { min-height: 44px; display: flex; align-items: center; padding: 0 16px; border-radius: 24px; font-size: var(--type-small); color: var(--color-graphite); }
  nav a[aria-current] { background: #EEEEF0; color: var(--color-ink); font-weight: 500; }
  nav a:hover { background: #E8E8EC; color: var(--color-ink); }
  .site-name:hover { color: var(--color-accent); }
  .desktop-nav { display: flex; gap: 4px; }
  .desktop-nav [data-contact-open] { margin-left: 22px; padding-right: 0; border-radius: 0; }
  .desktop-nav [data-contact-open]:hover { background: transparent; text-decoration: underline; text-underline-offset: 5px; }
  .mobile-nav { display: none; }
  @media (max-width: 809px) {
    .desktop-nav { display: none; }
    .mobile-nav { display: block; }
    summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: '+'; margin-left: 12px; }
    details[open] summary::after { content: '-'; }
    .mobile-nav nav { position: absolute; top: 100%; left: 0; right: 0; padding: 12px var(--gutter) 20px; background: var(--color-paper); border-bottom: 1px solid var(--color-rule); box-shadow: 0 12px 20px #14141a08; }
    .mobile-nav nav a { padding: 8px 16px; }
  }
</style>
