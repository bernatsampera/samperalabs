---
export interface Props {
  /** Night: inside the dark lower section of the home page. Light: every other page. */
  tone?: 'light' | 'night';
  topId?: string;
}
const {tone = 'light', topId = 'top'} = Astro.props;
---

<footer class:list={['site-foot', tone]}>
  <div class="col">
    <a class="up" href={`#${topId}`}><svg class="ico" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 10V2.5M2.5 6 6 2.5 9.5 6"></path></svg>Back to top</a>
    <nav aria-label="Contact">
      <a href="https://x.com/bsampera97">X</a>
      <a href="https://www.linkedin.com/in/bernat-sampera-195152107/">LinkedIn</a>
      <a href="/rss.xml">RSS</a>
      <a href="mailto:info@samperalabs.com">info@samperalabs.com</a>
    </nav>
  </div>
</footer>

<style>
  .site-foot .col {
    min-height: var(--nav-h); display: flex; align-items: center; justify-content: space-between; gap: var(--space-4);
    font-size: var(--type-meta); line-height: var(--leading-meta);
  }
  .site-foot.light { margin-top: var(--space-10); }
  .site-foot.light .col { border-top: var(--border-hairline); color: var(--color-slate); }
  .site-foot.night .col { border-top: 1px solid #232327; color: var(--color-night-text); }
  .site-foot nav { display: flex; flex-wrap: wrap; gap: var(--space-6); }
  .site-foot a { color: inherit; text-decoration: none; }
  .site-foot a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .site-foot.light a:hover { color: var(--color-ink); }
  .up { display: inline-flex; align-items: center; gap: var(--space-1); }
  .site-foot.night :focus-visible { outline-color: var(--color-night-text); }
  @media (max-width: 809px) {
    .site-foot .col { flex-direction: column; justify-content: center; align-items: flex-start; gap: var(--space-3); padding: var(--space-5) 0; }
    .site-foot nav { gap: var(--space-5); }
  }
</style>
